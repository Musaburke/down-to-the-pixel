---
import '../styles/global.css';

interface Props { title?: string; description?: string }
const {
  title = 'Down to the pixel',
  description = 'Follow one key press from your fingertip to a single lit pixel.',
} = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0c0c0b" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href="/fonts/instrument-serif-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/schibsted-grotesk-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/poster/desk-wide.webp" as="image" media="(min-width: 761px)" />
    <link rel="preload" href="/poster/desk-tall.webp" as="image" media="(max-width: 760px)" />
  </head>
  <body>
    <slot />
  </body>
</html>
